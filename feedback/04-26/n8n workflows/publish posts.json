    {
      "parameters": {
        "jsCode": "// 1. Get the raw text output from Gemini\nconst rawText = $input.item.json.content.parts[0].text;\n\n// 2. Clean markdown and handle common JSON-breaking characters\nconst cleanJson = rawText\n  .replace(/^```json\\s*|```$/g, '') // Remove markdown code blocks\n  .replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, \"\") // Remove hidden control characters\n  .trim();\n\ntry {\n  const parsedData = JSON.parse(cleanJson);\n  \n  // 3. Optional: If Gemini returns an array [ { ... } ], \n  // we extract the first object to keep the workflow consistent.\n  const finalData = Array.isArray(parsedData) ? parsedData[0] : parsedData;\n\n  return {\n    json: finalData\n  };\n} catch (error) {\n  return {\n    json: {\n      error: \"Failed to parse JSON\",\n      raw_output: rawText,\n      message: error.message\n    }\n  };\n}"
      },
