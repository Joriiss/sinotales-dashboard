    {
      "parameters": {
        "jsCode": "// 1. Get content\nlet content = $('get earliest unpublished post').first().json.blog_posts[0].acf.main_content;\n\n// 2. Get images\nconst allImages = $('loop over images').all();\n\n// DEBUG: Let's see what we are working with\nconsole.log(`Processing ${allImages.length} images.`);\n\nfor (const item of allImages) {\n    // Access the object directly (based on your \"Format Image Data\" output)\n    // Your Set node output is: { \"original_id\": 16, \"full_url\": \"...\", ... }\n    // It is NOT nested inside \"image_info\" based on your Pin Data!\n    // It is directly in item.json.\n    const img = item.json; \n    \n    if (img && img.full_url) {\n        // Use 1536 if valid, else full url\n        const finalUrl = img.url_1536 || img.full_url;\n        const altText = img.alt_text || '';\n        const caption = img.caption || '';\n        const id = img.original_id;\n\n        // Force string for matching\n        const placeholder = `[IMG-${id}]`;\n        \n        // Build tag\n        const htmlTag = `<img src=\"${finalUrl}\" alt=\"${altText}\" class=\"st-post-image\" loading=\"lazy\" /><p class=\"st-caption\">${caption}</p>`;\n        \n        // Check if placeholder exists before replacing (good for debugging)\n        if (content.includes(placeholder)) {\n            content = content.split(placeholder).join(htmlTag);\n        } else {\n            console.log(`Placeholder ${placeholder} not found in text.`);\n        }\n    }\n}\n\nreturn {\n    json: {\n        updated_main_content: content\n    }\n};"
      },
