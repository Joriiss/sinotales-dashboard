    {
      "parameters": {
        "jsCode": "const feed = $input.first().json;\nconst entries = feed.feed?.entry || [];\n\nconst yesterday = new Date();\nyesterday.setDate(yesterday.getDate() - 1);\nconst yesterdayStr = yesterday.toISOString().split('T')[0];\n// const yesterdayStr = '2025-11-15'\n\nconst includeShorts = $('loop over channels').first().json.include_shorts;\n\nconst newVideos = entries.filter(entry => {\n  const published = entry['published'];\n  const url = entry.link?.href || '';\n  const isShort = url.includes('/shorts/');\n  return published && published.startsWith(yesterdayStr) && (includeShorts || !isShort);\n});\n\n// If no videos, return a placeholder so the loop continues\nif (newVideos.length === 0) {\n  return [{ json: { skip: true } }];\n}\n\nreturn newVideos.map(video => ({ json: video }));\n"
      },
