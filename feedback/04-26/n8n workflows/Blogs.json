      "parameters": {
        "jsCode": "// yesterday in YYYY-MM-DD\nconst yesterday = new Date();\nyesterday.setDate(yesterday.getDate() - 1);\nconst yStr = yesterday.toISOString().split(\"T\")[0];\n// const yStr = '2025-11-04';\n\nconst input = items[0].json;        // your array wrapper\nconst urls = input.urlset.url;      // the URL entries\n\nconst result = [];\n\nfor (const entry of urls) {\n\tconst date = entry.lastmod.split(\"T\")[0];\n\tif (date === yStr) {\n\t\tresult.push({ json: entry });\n\t}\n}\n\n// If no result, return skip=true\nif (result.length === 0) {\n\treturn [\n\t\t{\n\t\t\tjson: {\n\t\t\t\tskip: true\n\t\t\t}\n\t\t}\n\t];\n}\n\nreturn result;\n"
      },
